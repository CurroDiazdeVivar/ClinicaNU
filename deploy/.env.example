# Plantilla de configuración para el OAuth provider (VPS)
# Copia este archivo a .env y rellena los valores.

# Client ID de la OAuth App de GitHub (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=tu_client_id_aqui

# Client Secret de la OAuth App de GitHub (generar con "Generate a new client secret")
GITHUB_CLIENT_SECRET=tu_client_secret_aqui
