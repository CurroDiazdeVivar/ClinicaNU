---
// Layout principal — Clínica Dra. Nuria Ugarte
export interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} | Clínica Dra. Nuria Ugarte</title>
</head>
<body>
  <!-- Header -->
  <header class="header">
    <div class="container header__inner">
      <a href="/" class="header__logo" aria-label="Clínica Dra. Nuria Ugarte - Inicio">
        <img
          src="/img/logo-clinica-header.png"
          alt="Clínica Dra. Nuria Ugarte"
          class="header__logo-img"
          width="126"
          height="55"
          loading="eager"
        />
      </a>

      <nav class="header__nav" id="main-nav" aria-label="Navegación principal">
        <a href="/" class="header__nav-link">Inicio</a>
        <a href="/equipo" class="header__nav-link">La Doctora</a>

        <div class="dropdown">
          <a href="/nutricion" class="header__nav-link dropdown-toggle" aria-haspopup="true" aria-expanded="false">
            <span>Nutrición Clínica</span>
            <svg class="dropdown-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <div class="dropdown-content" role="menu">
            <a href="/nutricion/dieta-fodmap" role="menuitem">Dieta FODMAP</a>
            <a href="/nutricion/dieta-equilibrada" role="menuitem">Dieta equilibrada</a>
            <a href="/nutricion/dieta-proteinada" role="menuitem">Dieta proteinada</a>
            <a href="/nutricion-deportiva" role="menuitem">Nutrición deportiva</a>
            <a href="/nutricion/micronutricion" role="menuitem">Micronutrición</a>
            <a href="/nutricion/intolerancia-alimentaria" role="menuitem">Intolerancia alimentaria</a>
            <a href="/nutricion/paciente-oncologico" role="menuitem">Nutrición en paciente oncológico</a>
            <a href="/epixlife" role="menuitem">EPIXLIFE</a>
          </div>
        </div>

        <div class="dropdown">
          <a href="/oncologia-cuidados" class="header__nav-link dropdown-toggle" aria-haspopup="true" aria-expanded="false">
            <span>Oncología y Cuidados</span>
            <svg class="dropdown-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <div class="dropdown-content" role="menu">
            <a href="/oncologia-cuidados/paciente-oncologico" role="menuitem">Cuidados en el paciente oncológico</a>
            <a href="/oncologia-cuidados/dermocosmetica" role="menuitem">Dermocosmética oncológica</a>
          </div>
        </div>

        <a href="/medicina-capilar" class="header__nav-link">Medicina Capilar</a>

        <div class="dropdown">
          <a href="/tecnologia" class="header__nav-link dropdown-toggle" aria-haspopup="true" aria-expanded="false">
            <span>Tecnología</span>
            <svg class="dropdown-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <div class="dropdown-content" role="menu">
            <a href="/tecnologia-tanita" role="menuitem">Tanita</a>
            <a href="/epixlife" role="menuitem">EPIXLIFE</a>
          </div>
        </div>

        <a href="/blog" class="header__nav-link">Blog</a>
        <a href="/contacto" class="header__nav-link">Contacto</a>

        <div class="header__cta-wrapper-mobile">
          <a href="/contacto" class="btn btn-primary header__cta-mobile">Reserva tu cita</a>
        </div>
      </nav>

      <div class="header__actions">
        <a href="/contacto" class="btn btn-primary header__cta">Reserva tu cita</a>
        <button class="header__menu-btn" aria-label="Abrir menú" aria-expanded="false" id="menu-toggle">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer__inner">
      <div class="footer__col">
        <img src="/img/logo-clinica-footer.png" alt="Clínica Dra. Nuria Ugarte" class="footer__logo" />
        <p>Médica especialista en nutrición clínica con 25 años de experiencia. Medicina basada en evidencia, tecnología avanzada y trato humano.</p>
      </div>
      <div class="footer__col">
        <h4>Servicios</h4>
        <nav aria-label="Servicios">
          <a href="/nutricion">Nutrición Clínica</a>
          <a href="/oncologia-cuidados">Oncología y Cuidados</a>
          <a href="/medicina-capilar">Medicina Capilar</a>
          <a href="/tecnologia-tanita">Tecnología Tanita</a>
        </nav>
      </div>
      <div class="footer__col">
        <h4>Tratamientos</h4>
        <nav aria-label="Tratamientos">
          <a href="/tratamientos/faciales">Faciales</a>
          <a href="/tratamientos/corporales">Corporales</a>
          <a href="/tratamientos/laser">Láser médico</a>
        </nav>
      </div>
      <div class="footer__col">
        <h4>Contacto</h4>
        <address>
          <p>Calle Ejemplo, 12 · 26001 Logroño, La Rioja</p>
          <p>📞 <a href="tel:+34941234567">941 234 567</a></p>
          <p>✉️ <a href="mailto:info@clinicanuriaugarte.es">info@clinicanuriaugarte.es</a></p>
        </address>
      </div>
      <div class="footer__col">
        <h4>Horario</h4>
        <p>Lunes a Viernes: 9:00 - 14:00 · 16:00 - 20:00</p>
        <p>Sábados: 9:00 - 13:00</p>
      </div>
    </div>
    <div class="footer__bottom">
      <div class="container">
        <p>© 2025 Clínica Dra. Nuria Ugarte. Todos los derechos reservados.</p>
        <nav aria-label="Legal">
          <a href="#">Aviso Legal</a>
          <a href="#">Política de Privacidad</a>
          <a href="#">Política de Cookies</a>
        </nav>
      </div>
    </div>
  </footer>

  <script>
    // Header Navigation & Mobile Menu Logic
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('main-nav');

    if (toggle && nav) {
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = nav.classList.toggle('header__nav--open');
        toggle.classList.toggle('is-active', isOpen);
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
      });
    }

    // Dropdown toggle functionality for mobile & tablet screens (click-based)
    document.querySelectorAll('.dropdown').forEach(dropdown => {
      const toggleLink = dropdown.querySelector('.dropdown-toggle');
      if (toggleLink) {
        toggleLink.addEventListener('click', (e) => {
          if (window.innerWidth <= 1024) {
            e.preventDefault();
            e.stopPropagation();
            const isCurrentlyActive = dropdown.classList.contains('active');

            // Close other open dropdowns in mobile accordion style
            document.querySelectorAll('.dropdown.active').forEach(other => {
              if (other !== dropdown) {
                other.classList.remove('active');
                other.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
              }
            });

            dropdown.classList.toggle('active', !isCurrentlyActive);
            toggleLink.setAttribute('aria-expanded', (!isCurrentlyActive).toString());
          }
        });
      }
    });

    // Close dropdowns and mobile menu when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && !target.closest('.dropdown')) {
        document.querySelectorAll('.dropdown.active').forEach(dropdown => {
          dropdown.classList.remove('active');
          dropdown.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
        });
      }
      if (target && !target.closest('.header') && nav && nav.classList.contains('header__nav--open')) {
        nav.classList.remove('header__nav--open');
        if (toggle) {
          toggle.classList.remove('is-active');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Abrir menú');
        }
      }
    });

    // Close mobile nav when clicking internal links (except dropdown toggles)
    nav?.querySelectorAll('a:not(.dropdown-toggle)').forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 1024 && nav.classList.contains('header__nav--open')) {
          nav.classList.remove('header__nav--open');
          if (toggle) {
            toggle.classList.remove('is-active');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', 'Abrir menú');
          }
        }
      });
    });
  </script>
</body>
</html>

<style>
  /* ============ HEADER ============ */
  .header {
    background: var(--color-white);
    border-bottom: 1px solid rgba(226, 226, 221, 0.8);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 10px rgba(27, 58, 92, 0.05);
    transition: box-shadow 0.25s ease;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.65rem;
    padding-bottom: 0.65rem;
    gap: 1.25rem;
    max-width: 1240px;
    margin: 0 auto;
  }

  /* Logo */
  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__logo-img {
    height: 52px;
    width: auto;
    max-height: 55px;
    display: block;
    object-fit: contain;
    transition: opacity 0.2s ease;
  }

  .header__logo:hover .header__logo-img {
    opacity: 0.9;
  }

  /* Nav Links Desktop */
  .header__nav {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.1vw, 1.2rem);
    margin: 0;
    padding: 0;
  }

  .header__nav-link {
    font-size: clamp(0.82rem, 0.88vw, 0.9rem);
    font-weight: 500;
    color: var(--color-text);
    padding: 0.5rem 0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    position: relative;
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: none;
    transition: color 0.2s ease;
  }

  .header__nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0.25rem;
    right: 0.25rem;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
  }

  .header__nav-link:hover {
    color: var(--color-primary);
  }

  .header__nav-link:hover::after,
  .dropdown:hover > .header__nav-link::after {
    transform: scaleX(1);
  }

  .dropdown:hover > .header__nav-link {
    color: var(--color-primary);
  }

  /* Dropdown indicator icon */
  .dropdown-chevron {
    transition: transform 0.25s ease, color 0.2s ease;
    opacity: 0.7;
    flex-shrink: 0;
  }

  .dropdown:hover .dropdown-chevron,
  .dropdown.active .dropdown-chevron {
    transform: rotate(180deg);
    opacity: 1;
    color: var(--color-primary);
  }

  /* Dropdown container */
  .dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  /* Invisible hover bridge */
  .dropdown::after {
    content: '';
    position: absolute;
    top: 100%;
    left: -10px;
    right: -10px;
    height: 14px;
    display: block;
  }

  /* Dropdown Panel */
  .dropdown-content {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 260px;
    background: var(--color-white);
    border: 1px solid rgba(226, 226, 221, 0.9);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(27, 58, 92, 0.12), 0 2px 6px rgba(0, 0, 0, 0.04);
    padding: 0.45rem 0;
    z-index: 1050;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.2s;
  }

  .dropdown:hover .dropdown-content,
  .dropdown:focus-within .dropdown-content {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Dropdown items */
  .dropdown-content a {
    display: block;
    padding: 0.65rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.35;
    white-space: nowrap;
    border-left: 3px solid transparent;
    transition: background-color 0.15s ease, color 0.15s ease, padding-left 0.15s ease, border-color 0.15s ease;
  }

  .dropdown-content a:hover {
    background: var(--color-bg-alt);
    color: var(--color-primary);
    border-left-color: var(--color-primary);
    padding-left: 1.45rem;
  }

  /* Actions & CTA */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .header__cta {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.55rem 1.25rem;
    border-radius: 50px;
    flex-shrink: 0;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(27, 58, 92, 0.18);
    transition: all 0.25s ease;
  }

  .header__cta:hover {
    background: var(--color-primary-light);
    color: var(--color-white);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(27, 58, 92, 0.28);
  }

  .header__cta-wrapper-mobile {
    display: none;
  }

  /* Hamburger Menu Button */
  .header__menu-btn {
    display: none;
    width: 42px;
    height: 42px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    cursor: pointer;
    padding: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .header__menu-btn:hover {
    background: var(--color-bg-alt);
    border-color: var(--color-primary-light);
  }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }

  .header__menu-btn.is-active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__menu-btn.is-active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .header__menu-btn.is-active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Responsive Breakpoint (Tablet & Mobile) */
  @media (max-width: 1024px) {
    .header__inner {
      padding-top: 0.55rem;
      padding-bottom: 0.55rem;
    }

    .header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-white);
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 1.25rem 1.75rem;
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 12px 28px rgba(27, 58, 92, 0.12);
      max-height: calc(100vh - 75px);
      overflow-y: auto;
      gap: 0;
      z-index: 1000;
    }

    .header__nav--open {
      display: flex;
      animation: menuSlideDown 0.22s ease-out forwards;
    }

    @keyframes menuSlideDown {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .header__nav-link {
      padding: 0.85rem 0.5rem;
      font-size: 0.95rem;
      font-weight: 500;
      border-bottom: 1px solid rgba(226, 226, 221, 0.5);
      justify-content: space-between;
      width: 100%;
    }

    .header__nav-link::after {
      display: none;
    }

    .dropdown {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: auto;
    }

    .dropdown::after {
      display: none;
    }

    .dropdown-content {
      position: static;
      display: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      pointer-events: auto;
      box-shadow: none;
      border: none;
      border-left: 2px solid var(--color-primary-light);
      border-radius: 0;
      background: var(--color-bg);
      margin: 0.35rem 0 0.65rem 0.75rem;
      padding: 0.35rem 0;
      min-width: unset;
      transition: none;
    }

    .dropdown.active .dropdown-content {
      display: block;
    }

    .dropdown-content a {
      padding: 0.6rem 1rem;
      font-size: 0.88rem;
      white-space: normal;
      border-left: none;
    }

    .dropdown-content a:hover {
      padding-left: 1rem;
      background: rgba(44, 111, 154, 0.08);
    }

    .header__cta-wrapper-mobile {
      display: block;
      padding-top: 1.25rem;
    }

    .header__cta-mobile {
      display: flex;
      justify-content: center;
      width: 100%;
      text-align: center;
      padding: 0.75rem 1.5rem;
    }

    .header__cta {
      display: none;
    }

    .header__menu-btn {
      display: flex;
    }
  }

  /* ============ FOOTER ============ */
  .footer {
    background: var(--color-primary);
    color: var(--color-white);
    padding: 4rem 0 0;
  }
  .footer__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding-bottom: 3rem;
  }
  .footer h4 {
    color: var(--color-white);
    font-family: var(--font-serif);
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }
  .footer__logo {
    height: 48px;
    width: auto;
    margin-bottom: 1rem;
    display: block;
  }
  .footer p, .footer address p {
    color: rgba(255,255,255,0.8);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    font-style: normal;
  }
  .footer a {
    color: rgba(255,255,255,0.8);
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.9rem;
  }
  .footer a:hover { color: var(--color-white); }
  .footer__bottom {
    border-top: 1px solid rgba(255,255,255,0.15);
    padding: 1.5rem 0;
  }
  .footer__bottom > .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer__bottom p {
    font-size: 0.8rem;
    margin: 0;
  }
  .footer__bottom nav {
    display: flex;
    gap: 1rem;
  }
  .footer__bottom nav a {
    font-size: 0.8rem;
    display: inline;
  }
  @media (max-width: 1024px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
