---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace('src/content/blog/', '').replace('.md', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.excerpt}>
  <PageHeader
    title={post.data.title}
    date={post.data.date.toLocaleDateString('es', { year: 'numeric', month: 'long', day: 'numeric' })}
    author={post.data.author}
  />

  <section class="section">
    <div class="container" style="max-width: 750px; margin: 0 auto;">
      <Content />
      <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border);">
        <a href="/blog" class="btn btn-outline">← Volver al blog</a>
      </div>
    </div>
  </section>
</Layout>
