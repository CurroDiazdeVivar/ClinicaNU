---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Blog" description="Artículos sobre nutrición clínica, salud y bienestar escritos por la Dra. Nuria Ugarte. Información rigurosa y basada en evidencia.">
  <PageHeader title="Blog" description="Artículos sobre nutrición clínica, salud y bienestar, escritos por la Dra. Nuria Ugarte." />

  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <article class="card blog-card">
            <div class="blog-card__image-placeholder">
              <svg class="blog-card__icon" xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <div class="blog-card__content">
              <span class="blog-card__date">{post.data.date.toLocaleDateString('es', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.excerpt}</p>
              <a href={`/blog/${post.slug}`} class="blog-card__link">Leer más →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }
  .blog-card {
    padding: 0;
    overflow: hidden;
  }
  .blog-card__image-placeholder {
    height: 180px;
    background: linear-gradient(135deg, rgba(27, 58, 92, 0.05) 0%, rgba(26, 188, 156, 0.15) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }
  .blog-card__icon {
    opacity: 0.7;
  }
  .blog-card__content {
    padding: 1.5rem;
  }
  .blog-card__date {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    display: block;
  }
  .blog-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.8rem;
  }
  .blog-card p {
    font-size: 0.95rem;
  }
  .blog-card__link {
    display: inline-block;
    margin-top: 0.8rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
