---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';
const secciones = await getCollection('secciones');
const sec = secciones.find(s => s.id.includes('equipo'));
const { Content } = await render(sec);
---

<Layout title="Equipo" description="Conozca al equipo médico de la Clínica Dra. Nuria Ugarte en Logroño. Especialistas en nutrición clínica, cuidados oncológicos y medicina regenerativa.">
  <PageHeader title="Nuestro Equipo" description="Profesionales sanitarios comprometidos con su salud." />
  <section class="section">
    <div class="container" style="max-width: 800px; margin: 0 auto;">
      <div class="card team-member">
        <div class="team-member__image">
          <img src="/uploads/dra-nuria-ugarte.jpg" alt="Dra. Nuria Ugarte" class="team-member__img" width="400" height="400" loading="eager" />
        </div>
        <div class="team-member__info">
          <h2>Dra. Nuria Ugarte</h2>
          <p class="team-member__role">Médica especialista en Nutrición Clínica</p>
          <Content />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .team-member {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.5rem;
    align-items: start;
    padding: 2.5rem;
  }
  .team-member__image {
    width: 100%;
  }
  .team-member__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    display: block;
  }
  .team-member__role {
    color: var(--color-accent);
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 768px) {
    .team-member {
      grid-template-columns: 1fr;
    }
    .team-member__image {
      max-width: 250px;
      margin: 0 auto;
    }
  }
</style>
