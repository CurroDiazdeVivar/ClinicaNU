---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const home = await getEntry('pages', 'home');
const { data } = home;
---

<Layout title="Inicio" description="Clínica Dra. Nuria Ugarte. Médica especialista en nutrición clínica en Logroño. 25 años de experiencia. Tecnología Tanita. Medicina basada en evidencia.">
  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="hero__badge">Médica especialista · 25 años de experiencia</span>
        <h1>{data.hero_title ? data.hero_title.replace(/\s+en\s+Logroño$/i, '') : ''} <span class="highlight">en Logroño</span></h1>
        <p class="hero__subtitle">{data.hero_subtitle}</p>
        <div class="hero__ctas">
          <a href="/contacto" class="btn btn-primary">{data.hero_cta}</a>
          <a href="/nutricion" class="btn btn-outline">Cómo funciona</a>
        </div>
        <div class="hero__trust">
          <span class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            25 años de experiencia
          </span>
          <span class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Medicina basada en evidencia
          </span>
          <span class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Tecnología Tanita
          </span>
        </div>
      </div>
      <div class="hero__image">
        <div class="hero__image-card">
          <img src="/ClinicaNU/uploads/dra-nuria-ugarte.jpg" alt="Dra. Nuria Ugarte" class="hero__image-img" width="640" height="480" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== DIFERENCIACIÓN ===== -->
  <section class="section bg-alt">
    <div class="container">
      <h2 class="section__title-centered">{data.section_why_title}</h2>
      <p class="section__subtitle-centered">{data.section_why_subtitle}</p>
      <div class="grid-3">
        <div class="card diff-card">
          <div class="diff-icon-wrapper">
            <svg class="diff-icon-svg" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3>{data.diff_1_title}</h3>
          <p>{data.diff_1_text}</p>
        </div>
        <div class="card diff-card">
          <div class="diff-icon-wrapper">
            <svg class="diff-icon-svg" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
          <h3>{data.diff_2_title}</h3>
          <p>{data.diff_2_text}</p>
        </div>
        <div class="card diff-card">
          <div class="diff-icon-wrapper">
            <svg class="diff-icon-svg" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <h3>{data.diff_3_title}</h3>
          <p>{data.diff_3_text}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SERVICIOS ===== -->
  <section class="section">
    <div class="container">
      <h2 class="section__title-centered">{data.section_services_title}</h2>
      <p class="section__subtitle-centered">{data.section_services_subtitle}</p>
      <div class="grid-3">
        <a href={data.service_1_link} class="card service-card">
          <img src="/img/tarjeta-nutricion.jpg" alt={data.service_1_title} class="card-image" width="600" height="360" loading="lazy" />
          <div class="service-card__body">
            <h3>{data.service_1_title}</h3>
            <p>{data.service_1_text}</p>
            <span class="service-link">Más información →</span>
          </div>
        </a>
        <a href={data.service_2_link} class="card service-card">
          <img src="/img/tarjeta-oncologia.jpg" alt={data.service_2_title} class="card-image" width="600" height="360" loading="lazy" />
          <div class="service-card__body">
            <h3>{data.service_2_title}</h3>
            <p>{data.service_2_text}</p>
            <span class="service-link">Más información →</span>
          </div>
        </a>
        <a href={data.service_3_link} class="card service-card">
          <img src="/img/tarjeta-capilar.jpg" alt={data.service_3_title} class="card-image" width="600" height="360" loading="lazy" />
          <div class="service-card__body">
            <h3>{data.service_3_title}</h3>
            <p>{data.service_3_text}</p>
            <span class="service-link">Más información →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== SOBRE LA DRA. ===== -->
  <section class="section bg-alt">
    <div class="container about">
      <div class="about__image">
        <img src="/ClinicaNU/uploads/dra-nuria-ugarte.jpg" alt="Dra. Nuria Ugarte" class="about__image-img" width="600" height="400" loading="lazy" />
      </div>
      <div class="about__content">
        <h2>{data.section_about_title}</h2>
        <p>{data.about_text}</p>
        <a href="/equipo" class="btn btn-primary">Conoce al equipo</a>
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIOS ===== -->
  <section class="section">
    <div class="container">
      <h2 class="section__title-centered">{data.section_testimonials_title}</h2>
      <div class="grid-3 testimonials">
        <div class="card testimonial">
          <p>"{data.testimonial_1_text}"</p>
          <div class="testimonial__author">
            <strong>{data.testimonial_1_name}</strong>
          </div>
        </div>
        <div class="card testimonial">
          <p>"{data.testimonial_2_text}"</p>
          <div class="testimonial__author">
            <strong>{data.testimonial_2_name}</strong>
          </div>
        </div>
        <div class="card testimonial">
          <p>"{data.testimonial_3_text}"</p>
          <div class="testimonial__author">
            <strong>{data.testimonial_3_name}</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== OTROS TRATAMIENTOS ===== -->
  <section class="section">
    <div class="container">
      <h2 class="section__title-centered">{data.section_others_title}</h2>
      <p class="section__subtitle-centered">{data.section_others_subtitle}</p>
      <div class="grid-3">
        <a href={data.other_1_link} class="card service-card">
          <img src="/img/tarjeta-facial.jpg" alt={data.other_1_title} class="card-image" width="600" height="360" loading="lazy" />
          <div class="service-card__body">
            <h3>{data.other_1_title}</h3>
            <p>{data.other_1_text}</p>
            <span class="service-link">Ver tratamientos →</span>
          </div>
        </a>
        <a href={data.other_2_link} class="card service-card">
          <img src="/img/tarjeta-corporal.jpg" alt={data.other_2_title} class="card-image" width="600" height="360" loading="lazy" />
          <div class="service-card__body">
            <h3>{data.other_2_title}</h3>
            <p>{data.other_2_text}</p>
            <span class="service-link">Ver tratamientos →</span>
          </div>
        </a>
        <a href={data.other_3_link} class="card service-card">
          <img src="/img/tarjeta-laser.jpg" alt={data.other_3_title} class="card-image" width="600" height="360" loading="lazy" />
          <div class="service-card__body">
            <h3>{data.other_3_title}</h3>
            <p>{data.other_3_text}</p>
            <span class="service-link">Ver tratamientos →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== CTA FINAL ===== -->
  <section class="section cta-final">
    <div class="container cta-final__inner">
      <h2>{data.section_cta_title}</h2>
      <p>{data.section_cta_text}</p>
      <a href={data.section_cta_link} class="btn btn-primary btn-lg">{data.section_cta_button}</a>
      <p class="cta-final__phone">O llámenos al <a href="tel:+34941234567">941 234 567</a></p>
    </div>
  </section>
</Layout>

<style>
  /* ===== HERO ===== */
  .hero {
    padding: 5rem 0 4.5rem;
    background: linear-gradient(160deg, #FFFFFF 0%, var(--color-bg) 50%, var(--color-bg-alt) 100%);
    position: relative;
    border-bottom: 1px solid var(--color-border);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    background: rgba(58, 125, 68, 0.1);
    color: var(--color-accent);
    border: 1px solid rgba(58, 125, 68, 0.25);
    padding: 0.45rem 1.1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 3.5vw + 0.5rem, 3.2rem);
    line-height: 1.18;
    margin-bottom: 1.25rem;
  }
  .highlight {
    color: var(--color-accent);
  }
  .hero__subtitle {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    line-height: 1.7;
    max-width: 540px;
  }
  .hero__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .hero__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }
  .hero__trust-item svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .hero__image {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .hero__image-card {
    width: 100%;
    max-width: 460px;
    border-radius: 20px;
    background: var(--color-white);
    padding: 0.6rem;
    box-shadow: 0 16px 36px -10px rgba(27, 58, 92, 0.15), 0 0 0 1px rgba(27, 58, 92, 0.08);
  }
  .hero__image-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    object-position: center 25%;
    border-radius: 16px;
    display: block;
  }

  @media (max-width: 1024px) {
    .hero {
      padding: 3.5rem 0;
    }
    .hero__inner {
      gap: 2.5rem;
    }
    .hero h1 { font-size: 2.4rem; }
    .hero__image-img {
      height: 320px;
    }
  }
  @media (max-width: 768px) {
    .hero {
      padding: 3rem 0;
    }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero h1 { font-size: 2.1rem; }
    .hero__image {
      order: -1;
    }
    .hero__image-card {
      max-width: 100%;
    }
    .hero__image-img {
      height: 260px;
    }
  }

  /* ===== DIFERENCIACIÓN ===== */
  .bg-alt {
    background: var(--color-bg-alt);
  }
  .section__title-centered {
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .section__subtitle-centered {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }
  .diff-card {
    text-align: center;
    padding: 2.25rem 1.75rem;
  }
  .diff-icon-wrapper {
    width: 52px;
    height: 52px;
    margin: 0 auto 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(27, 58, 92, 0.08);
    color: var(--color-primary);
  }
  .diff-icon-svg {
    width: 24px;
    height: 24px;
  }
  .diff-card h3 {
    margin-bottom: 0.8rem;
  }

  /* ===== SERVICIOS (TARJETAS CON IMAGEN) ===== */
  .service-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .card-image {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    transition: transform 0.3s ease;
  }
  .service-card:hover .card-image {
    transform: scale(1.03);
  }
  .service-card__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .service-card__body h3 {
    margin-bottom: 0.75rem;
  }
  .service-card__body p {
    flex-grow: 1;
    margin-bottom: 1rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .service-link {
    display: inline-block;
    font-weight: 600;
    color: var(--color-primary-light);
    font-size: 0.9rem;
    margin-top: auto;
  }

  /* ===== ABOUT ===== */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .about__image-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    object-position: center 25%;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }
  @media (max-width: 1024px) {
    .about {
      gap: 3rem;
    }
  }
  @media (max-width: 768px) {
    .about {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .about__image-img {
      height: 280px;
    }
  }

  /* ===== TESTIMONIOS ===== */
  .testimonial p {
    font-style: italic;
    font-size: 1rem;
    line-height: 1.7;
  }
  .testimonial__author {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .testimonial__author strong {
    color: var(--color-primary);
  }
  .testimonial__author span {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  /* ===== CTA FINAL ===== */
  .cta-final {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: var(--color-white);
    text-align: center;
  }
  .cta-final h2 {
    color: var(--color-white);
    margin-bottom: 1rem;
  }
  .cta-final p {
    color: rgba(255,255,255,0.9);
    max-width: 600px;
    margin: 0 auto 2rem;
  }
  .cta-final__phone {
    margin-top: 1rem;
    font-size: 1rem;
  }
  .cta-final__phone a {
    color: var(--color-white);
    font-weight: 600;
  }
  .btn-lg {
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
  }
</style>
