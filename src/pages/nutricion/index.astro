---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';
const secciones = await getCollection('secciones');
const sec = secciones.find(s => s.id.includes('nutricion'));
const { Content } = await render(sec);
---

<Layout title="Nutrición Clínica" description="Planes personalizados de nutrición médica en Logroño. Evaluación con balanza Tanita, seguimiento digital y supervisión de la Dra. Nuria Ugarte. 25 años de experiencia.">
  <PageHeader title="Nutrición Clínica" description="Planes médicos personalizados con evaluación precisa y seguimiento continuo." />

  <section class="section">
    <div class="container service-content">
      <div class="service-content__main">
        <Content />
      </div>
      <div class="service-content__sidebar">
        <div class="card">
          <h3>Su tratamiento, paso a paso</h3>
          <ul>
            <li><strong>Primera consulta:</strong> historia médica, historia nutricional, análisis de la composición corporal y exploración física.</li>
            <li><strong>Plan personalizado:</strong> objetivos realistas, pautas claras adaptadas a cada paciente.</li>
            <li><strong>Seguimiento:</strong> revisiones periódicas médicas, apoyo continuo y registro alimentario semanal.</li>
            <li><strong>Mantenimiento:</strong> control de su evolución a largo plazo para consolidar los resultados y prevenir recaídas.</li>
            <li><strong>App móvil:</strong> informe detallado de su análisis corporal Tanita (BIA multifrecuencia), directamente en su móvil.</li>
          </ul>
        </div>
        <a href="/contacto" class="btn btn-primary" style="width:100%;text-align:center;">Reserva tu primera consulta</a>
      </div>
    </div>
  </section>

  <section class="section bg-alt">
    <div class="container">
      <h2 class="section__title-centered">Tecnología Tanita</h2>
      <p class="section__subtitle-centered">La balanza Tanita de última generación mide con precisión su composición corporal: masa muscular, grasa visceral, agua corporal, metabolismo basal y más. Un informe digital que guía el tratamiento con datos objetivos, no con suposiciones.</p>
      <div style="text-align:center;">
        <a href="/tecnologia-tanita" class="btn btn-outline">Conoce la tecnología Tanita</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .service-content__main h2 {
    margin-bottom: 1.5rem;
  }
  .service-content__main h3 {
    margin: 2rem 0 1rem;
  }
  .service-content__main ul {
    list-style: none;
    padding: 0;
  }
  .service-content__main li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .service-content__main li:last-child {
    border-bottom: none;
  }
  .service-content__sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .service-content__sidebar ul {
    padding-left: 1.2rem;
    list-style-type: '-';
  }
  .service-content__sidebar ul li {
    margin-bottom: 0.5rem;
  }

  .bg-alt {
    background: var(--color-bg-alt);
  }
  .section__title-centered {
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .section__subtitle-centered {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 2rem;
  }

  @media (max-width: 768px) {
    .service-content {
      grid-template-columns: 1fr;
    }
  }
</style>
