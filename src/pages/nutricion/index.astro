---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
const secciones = await getCollection('secciones');
const sec = secciones.find(s => s.id.includes('nutricion'));
const { Content } = await render(sec);
---

<Layout title="Nutrición Clínica" description="Planes personalizados de nutrición médica en Logroño. Evaluación con balanza Tanita, seguimiento digital y supervisión de la Dra. Nuria Ugarte. 25 años de experiencia.">
  <section class="page-header">
    <div class="container">
      <h1>Nutrición Clínica</h1>
      <p>Planes médicos personalizados con evaluación precisa y seguimiento continuo.</p>
    </div>
  </section>

  <section class="section">
    <div class="container service-content">
      <div class="service-content__main">
        <Content />
      </div>
      <div class="service-content__sidebar">
        <div class="card">
          <h3>📋 El proceso</h3>
          <ol>
            <li><strong>Primera consulta:</strong> historia clínica y medición Tanita.</li>
            <li><strong>Plan personalizado:</strong> objetivo realista, pautas claras.</li>
            <li><strong>Seguimiento:</strong> revisiones periódicas y ajustes.</li>
            <li><strong>App digital:</strong> acceso a su evolución desde casa.</li>
          </ol>
        </div>
        <div class="card">
          <h3>💶 Tarifas</h3>
          <p>Primera consulta: <strong>60€</strong></p>
          <p>Revisiones: <strong>40€</strong></p>
          <p>Incluye informe Tanita digital.</p>
        </div>
        <a href="/contacto" class="btn btn-primary" style="width:100%;text-align:center;">Reserva tu consulta</a>
      </div>
    </div>
  </section>

  <section class="section bg-alt">
    <div class="container">
      <h2 class="section__title-centered">Tecnología Tanita</h2>
      <p class="section__subtitle-centered">La balanza Tanita de última generación mide con precisión su composición corporal: masa muscular, grasa visceral, agua corporal, metabolismo basal y más. Un informe digital que guía el tratamiento con datos objetivos, no con suposiciones.</p>
      <div style="text-align:center;">
        <a href="/tecnologia-tanita" class="btn btn-outline">Conoce la tecnología Tanita</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: var(--color-white);
    padding: 4rem 0 3rem;
    text-align: center;
  }
  .page-header h1 { color: var(--color-white); }
  .page-header p { color: rgba(255,255,255,0.9); max-width: 500px; margin: 0 auto; }

  .service-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .service-content__main h2 {
    margin-bottom: 1.5rem;
  }
  .service-content__main h3 {
    margin: 2rem 0 1rem;
  }
  .service-content__main ul {
    list-style: none;
    padding: 0;
  }
  .service-content__main li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .service-content__main li:last-child {
    border-bottom: none;
  }
  .service-content__sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .service-content__sidebar ol {
    padding-left: 1.2rem;
  }
  .service-content__sidebar ol li {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .service-content {
      grid-template-columns: 1fr;
    }
  }
</style>
