---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';
const secciones = await getCollection('secciones');
const sec = secciones.find(s => s.id.includes('oncologia-cuidados'));
const { Content } = await render(sec);
---

<Layout title="Oncología y Cuidados" description="Cuidados médicos especializados para pacientes oncológicos en Logroño. Nutrición, dermatología y calidad de vida durante y después del tratamiento oncológico.">
  <PageHeader title="Oncología y Cuidados" description="Cuidados médicos integrales para pacientes oncológicos, con enfoque clínico y humano." />

  <section class="section">
    <div class="container service-content">
      <div class="service-content__main">
        <Content />
        <div class="grid-2" style="margin-top: 2rem;">
          <div class="card">
            <h3>Cuidados en el paciente oncológico</h3>
            <p>Nutrición, cuidado de la piel y calidad de vida durante y después del tratamiento.</p>
            <a href="/oncologia-cuidados/paciente-oncologico" class="btn btn-outline" style="margin-top: 1rem;">Ver detalles</a>
          </div>
          <div class="card">
            <h3>Dermocosmética oncológica</h3>
            <p>Productos y tratamientos dermatológicos seguros y eficaces durante el tratamiento oncológico.</p>
            <a href="/oncologia-cuidados/dermocosmetica" class="btn btn-outline" style="margin-top: 1rem;">Ver detalles</a>
          </div>
        </div>
      </div>
      <div class="service-content__sidebar">
        <div class="card">
          <h3>Enfoque integral</h3>
          <p>Todos los tratamientos son supervisados por la Dra. Ugarte y coordinados con su oncólogo. No realizamos procedimientos sin el visto bueno del equipo médico que lleva su caso.</p>
        </div>
        <a href="/contacto" class="btn btn-primary" style="width:100%;text-align:center;">Solicita información</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .service-content__main h2 { margin-bottom: 1.5rem; }
  .service-content__main h3 { margin: 2rem 0 1rem; }
  .service-content__main ul { list-style: none; padding: 0; }
  .service-content__main li { padding: 0.6rem 0; border-bottom: 1px solid var(--color-border); }
  .service-content__main li:last-child { border-bottom: none; }
  .service-content__sidebar { display: flex; flex-direction: column; gap: 1.5rem; }
  @media (max-width: 1024px) {
    .service-content { gap: 2rem; }
  }
  @media (max-width: 768px) {
    .service-content { grid-template-columns: 1fr; }
  }
</style>