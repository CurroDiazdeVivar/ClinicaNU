---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';
const secciones = await getCollection('secciones');
const sec = secciones.find(s => s.id.includes('testimonios'));
const { Content } = await render(sec);
---

<Layout title="Testimonios de pacientes" description="Experiencias reales de pacientes de la Clínica Dra. Nuria Ugarte en Logroño.">
  <PageHeader title="Testimonios" description="Experiencias reales de nuestros pacientes." />
  <section class="section">
    <div class="container">
      <Content />
      <div class="grid-3">
        <div class="card testimonial">
          <p>"Tras mi tratamiento oncológico, la Dra. Ugarte me ayudó a recuperar mi energía y mejorar mi estado nutricional. Su seguimiento personalizado hizo la diferencia en mi recuperación."</p>
          <div class="testimonial__author">
            <strong>Mª Ángeles, 45 años</strong>
            <span>Logroño</span>
          </div>
        </div>
        <div class="card testimonial">
          <p>"Llevaba años con problemas digestivos que nadie lograba resolver. Con la dieta FODMAP y el seguimiento de la Dra. Ugarte, por fin tengo una vida normal sin molestias."</p>
          <div class="testimonial__author">
            <strong>Carlos, 38 años</strong>
            <span>Logroño</span>
          </div>
        </div>
        <div class="card testimonial">
          <p>"La tecnología Tanita me permitió entender mi cuerpo como nunca antes. Con su ayuda, logré mis objetivos de composición corporal de forma sostenible y saludable."</p>
          <div class="testimonial__author">
            <strong>Ana, 52 años</strong>
            <span>Logroño</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .testimonial p {
    font-style: italic;
    font-size: 1rem;
    line-height: 1.7;
  }
  .testimonial__author {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .testimonial__author strong {
    color: var(--color-primary);
  }
  .testimonial__author span {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>