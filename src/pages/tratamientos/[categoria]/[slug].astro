---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const tratamientos = await getCollection('tratamientos');
  return tratamientos.map((tratamiento) => {
    const categoria = tratamiento.data.categoria;
    let slug = tratamiento.id.replace('.md', '');
    if (slug === 'radiofrecuencia-facial' || slug === 'facial-radiofrecuencia') {
      slug = 'radiofrecuencia';
    } else if (slug === 'radiofrecuencia-corporal' || slug === 'corporal-radiofrecuencia') {
      slug = 'radiofrecuencia';
    }

    return {
      params: {
        categoria,
        slug,
      },
      props: {
        tratamiento,
      },
    };
  });
}

const { tratamiento } = Astro.props;
const { Content } = await render(tratamiento);
---

<Layout title={tratamiento.data.title} description={tratamiento.data.description}>
  <PageHeader
    title={tratamiento.data.title}
    description={tratamiento.data.description}
    image={tratamiento.data.image && tratamiento.data.image.trim() !== '' ? tratamiento.data.image : undefined}
  />

  <section class="section">
    <div class="container service-content">
      <div class="service-content__main">
        <Content />
      </div>
      <div class="service-content__sidebar">
        <div class="card">
          <h3>Su tratamiento, paso a paso</h3>
          <ul>
            <li><strong>Consulta médica:</strong> Evaluación personalizada.</li>
            <li><strong>Diagnóstico:</strong> Plan de tratamiento adaptado.</li>
            <li><strong>Tratamiento:</strong> Aplicación del procedimiento.</li>
            <li><strong>Seguimiento:</strong> Revisiones periódicas.</li>
            <li><strong>Mantenimiento:</strong> control de su evolución a largo plazo para consolidar los resultados y prevenir recaídas.</li>
          </ul>
        </div>
        <a href="/contacto" class="btn btn-primary" style="width:100%;text-align:center;">Reserva tu primera consulta</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .service-content__main h2 {
    margin-bottom: 1.5rem;
  }
  .service-content__main h3 {
    margin: 2rem 0 1rem;
  }
  .service-content__main ul {
    list-style: none;
    padding: 0;
  }
  .service-content__main li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .service-content__main li:last-child {
    border-bottom: none;
  }
  .service-content__sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .service-content__sidebar h3 {
    margin-bottom: 1rem;
  }
  .service-content__sidebar ul {
    list-style-type: '-';
    padding-left: 1.2rem;
  }
  .service-content__sidebar ul li {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .service-content {
      grid-template-columns: 1fr;
    }
  }
</style>