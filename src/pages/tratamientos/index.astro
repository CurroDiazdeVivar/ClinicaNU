---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Tratamientos Médicos" description="Tratamientos médicos avanzados en medicina facial, corporal y láser. Siempre bajo supervisión de la Dra. Nuria Ugarte.">
  <section class="page-header">
    <div class="container">
      <h1>Tratamientos Médicos</h1>
      <p>Tratamientos médicos avanzados, siempre bajo supervisión de la Dra. Nuria Ugarte.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-3">
        <a href="/tratamientos/faciales" class="card service-card">
          <span class="service-icon">👤</span>
          <h3>Medicina Facial</h3>
          <p>Tratamientos médicos para el rostro: acne, rosácea, hidratación, hilos tensores, rellenos, peeling y radiofrecuencia.</p>
          <span class="service-link">Ver tratamientos →</span>
        </a>
        <a href="/tratamientos/corporales" class="card service-card">
          <span class="service-icon">胴</span>
          <h3>Medicina Corporal</h3>
          <p>Tratamientos médicos para el cuerpo: celulitis, mesoterapia, presoterapia, radiofrecuencia y esclerosis de varices.</p>
          <span class="service-link">Ver tratamientos →</span>
        </a>
        <a href="/tratamientos/laser" class="card service-card">
          <span class="service-icon">镭</span>
          <h3>Láser Médico</h3>
          <p>Tecnología láser médica para depilación, fotorejuvenecimiento, eliminación de tatuajes y tratamientos vasculares.</p>
          <span class="service-link">Ver tratamientos →</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: var(--color-white);
    padding: 4rem 0 3rem;
    text-align: center;
  }
  .page-header h1 { color: var(--color-white); }
  .page-header p { color: rgba(255,255,255,0.9); max-width: 500px; margin: 0 auto; }
  
  .service-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .service-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
  }
  .service-card h3 {
    margin-bottom: 0.8rem;
  }
  .service-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    color: var(--color-primary-light);
    font-size: 0.9rem;
  }
</style>