---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // This page is static, no dynamic paths needed
  return [
    { 
      params: {}, 
      props: {} 
    }
  ];
}

const tratamientos = await getCollection('tratamientos', ({ data }) => data.categoria === 'laser');
// Sort by order field if available, otherwise by title
const sortedTratamientos = tratamientos.sort((a, b) => {
  const orderA = a.data.order || 0;
  const orderB = b.data.order || 0;
  if (orderA !== orderB) {
    return orderA - orderB;
  }
  return a.data.title.localeCompare(b.data.title);
});
---

<Layout title="Láser Médico" description="Tratamientos médicos con láser: depilación, fotorejuvenecimiento, eliminación de tatuajes y tratamientos vasculares.">
  <section class="page-header">
    <div class="container">
      <h1>Láser Médico</h1>
      <p>Tecnología láser médica avanzada, siempre bajo supervisión de la Dra. Nuria Ugarte.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-3">
        {
          sortedTratamientos.map((tratamiento) => (
            <a href={`/tratamientos/${tratamiento.data.categoria}/${tratamiento.id.replace('.md', '').replace('laser/', '')}`} class="card service-card">
              <h3>{tratamiento.data.title}</h3>
              <p>{tratamiento.data.description}</p>
              <span class="service-link">Más información →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: var(--color-white);
    padding: 4rem 0 3rem;
    text-align: center;
  }
  .page-header h1 { color: var(--color-white); }
  .page-header p { color: rgba(255,255,255,0.9); max-width: 500px; margin: 0 auto; }
  
  .service-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .service-card h3 {
    margin-bottom: 0.8rem;
  }
  .service-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    color: var(--color-primary-light);
    font-size: 0.9rem;
  }
</style>